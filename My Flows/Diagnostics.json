                "type": "code",
                "value": [
                  "import os\r",
                  "import sys\r",
                  "import json\r",
                  "import time\r",
                  "import socket\r",
                  "import shutil\r",
                  "import platform\r",
                  "import tempfile\r",
                  "import threading\r",
                  "import subprocess\r",
                  "from datetime import datetime, timezone\r",
                  "\r",
                  "import requests\r",
                  "\r",
                  "from lfx.custom.custom_component.component import Component\r",
                  "from lfx.io import Output\r",
                  "from lfx.schema.message import Message\r",
                  "\r",
                  "_LOADED_AT = time.time()\r",
                  "_HISTORY_FILE = os.path.join(tempfile.gettempdir(), \"mds_platform_diag_history.json\")\r",
                  "\r",
                  "\r",
                  "def _read(path):\r",
                  "    try:\r",
                  "        with open(path, \"r\", encoding=\"utf-8\") as f:\r",
                  "            return f.read().strip()\r",
                  "    except Exception:\r",
                  "        return \"\"\r",
                  "\r",
                  "\r",
                  "def _gb(value):\r",
                  "    return str(round(value / (1024 ** 3), 1)) + \" GB\"\r",
                  "\r",
                  "\r",
                  "def _meminfo():\r",
                  "    info = {}\r",
                  "    for line in _read(\"/proc/meminfo\").splitlines():\r",
                  "        parts = line.split()\r",
                  "        if len(parts) >= 2:\r",
                  "            info[parts[0].rstrip(\":\")] = int(parts[1]) * 1024\r",
                  "    return info\r",
                  "\r",
                  "\r",
                  "def _cgroup_limits():\r",
                  "    notes = []\r",
                  "    cpu_max = _read(\"/sys/fs/cgroup/cpu.max\")\r",
                  "    if cpu_max:\r",
                  "        quota, period = (cpu_max.split() + [\"\", \"\"])[:2]\r",
                  "        if quota != \"max\" and period:\r",
                  "            notes.append(\"CPU limit (cgroup): \" + str(round(int(quota) / int(period), 2)) + \" cores\")\r",
                  "        else:\r",
                  "            notes.append(\"CPU limit (cgroup): none\")\r",
                  "    quota_v1 = _read(\"/sys/fs/cgroup/cpu/cpu.cfs_quota_us\")\r",
                  "    period_v1 = _read(\"/sys/fs/cgroup/cpu/cpu.cfs_period_us\")\r",
                  "    if quota_v1 and period_v1 and quota_v1 != \"-1\":\r",
                  "        notes.append(\"CPU limit (cgroup v1): \" + str(round(int(quota_v1) / int(period_v1), 2)) + \" cores\")\r",
                  "    mem_max = _read(\"/sys/fs/cgroup/memory.max\") or _read(\"/sys/fs/cgroup/memory/memory.limit_in_bytes\")\r",
                  "    if mem_max:\r",
                  "        if mem_max == \"max\" or int(mem_max) > 1 << 60:\r",
                  "            notes.append(\"Memory limit (cgroup): none\")\r",
                  "        else:\r",
                  "            notes.append(\"Memory limit (cgroup): \" + _gb(int(mem_max)))\r",
                  "    return notes\r",
                  "\r",
                  "\r",
                  "def _version(package):\r",
                  "    try:\r",
                  "        from importlib.metadata import version\r",
                  "        return version(package)\r",
                  "    except Exception:\r",
                  "        return \"not installed\"\r",
                  "\r",
                  "\r",
                  "def _dir_size(path):\r",
                  "    total = 0\r",
                  "    if not os.path.isdir(path):\r",
                  "        return None\r",
                  "    for root, _, files in os.walk(path):\r",
                  "        for name in files:\r",
                  "            try:\r",
                  "                total += os.path.getsize(os.path.join(root, name))\r",
                  "            except Exception:\r",
                  "                pass\r",
                  "    return total\r",
                  "\r",
                  "\r",
                  "class CustomComponent(Component):\r",
                  "    display_name = \"Platform Diagnostics\"\r",
                  "    description = \"Read-only check of the MDS runtime: CPU, memory, GPU, ffmpeg, tzdata, storage, workers and connectivity.\"\r",
                  "\r",
                  "    outputs = [\r",
                  "        Output(display_name=\"Report\", name=\"diag_report\", method=\"build_diag_report\"),\r",
                  "    ]\r",
                  "\r",
                  "    def build_diag_report(self) -> Message:\r",
                  "        lines = []\r",
                  "        now = time.time()\r",
                  "        host = socket.gethostname()\r",
                  "        pid = os.getpid()\r",
                  "\r",
                  "        lines.append(\"MDS PLATFORM DIAGNOSTICS - \" + datetime.now(timezone.utc).strftime(\"%Y-%m-%d %H:%M UTC\"))\r",
                  "        lines.append(\"\")\r",
                  "        lines.append(\"== Runtime ==\")\r",
                  "        lines.append(\"Host: \" + host + \" | PID: \" + str(pid))\r",
                  "        lines.append(\"Python: \" + sys.version.split()[0] + \" | OS: \" + platform.platform())\r",
                  "        lines.append(\"This process loaded the component \" + str(int((now - _LOADED_AT) / 60)) + \" min ago\")\r",
                  "        lines.append(\"Active threads: \" + str(threading.active_count()))\r",
                  "\r",
                  "        lines.append(\"\")\r",
                  "        lines.append(\"== CPU / Memory ==\")\r",
                  "        lines.append(\"CPU cores visible: \" + str(os.cpu_count()))\r",
                  "        try:\r",
                  "            lines.append(\"Load average (1/5/15 min): \" + \", \".join(str(round(x, 2)) for x in os.getloadavg()))\r",
                  "        except Exception:\r",
                  "            pass\r",
                  "        mem = _meminfo()\r",
                  "        if mem:\r",
                  "            lines.append(\r",
                  "                \"Memory total: \" + _gb(mem.get(\"MemTotal\", 0))\r",
                  "                + \" | available: \" + _gb(mem.get(\"MemAvailable\", 0))\r",
                  "            )\r",
                  "        lines.extend(_cgroup_limits())\r",
                  "\r",
                  "        lines.append(\"\")\r",
                  "        lines.append(\"== GPU ==\")\r",
                  "        if shutil.which(\"nvidia-smi\"):\r",
                  "            try:\r",
                  "                out = subprocess.run([\"nvidia-smi\", \"-L\"], capture_output=True, text=True, timeout=10)\r",
                  "                lines.append(\"nvidia-smi: \" + (out.stdout.strip() or out.stderr.strip() or \"no output\"))\r",
                  "            except Exception as e:\r",
                  "                lines.append(\"nvidia-smi error: \" + str(e)[:100])\r",
                  "        else:\r",
                  "            lines.append(\"nvidia-smi: not found\")\r",
                  "        try:\r",
                  "            import ctranslate2\r",
                  "            lines.append(\"CUDA devices (ctranslate2): \" + str(ctranslate2.get_cuda_device_count()))\r",
                  "        except Exception as e:\r",
                  "            lines.append(\"ctranslate2 CUDA check failed: \" + str(e)[:100])\r",
                  "\r",
                  "        lines.append(\"\")\r",
                  "        lines.append(\"== Tools / Packages ==\")\r",
                  "        ffmpeg = shutil.which(\"ffmpeg\")\r",
                  "        if ffmpeg:\r",
                  "            try:\r",
                  "                out = subprocess.run([ffmpeg, \"-version\"], capture_output=True, text=True, timeout=10)\r",
                  "                lines.append(\"ffmpeg: \" + out.stdout.splitlines()[0])\r",
                  "            except Exception:\r",
                  "                lines.append(\"ffmpeg: found at \" + ffmpeg)\r",
                  "        else:\r",
                  "            lines.append(\"ffmpeg: NOT installed\")\r",
                  "        try:\r",
                  "            from zoneinfo import ZoneInfo\r",
                  "            et = datetime.now(ZoneInfo(\"America/New_York\")).strftime(\"%H:%M %Z\")\r",
                  "            lines.append(\"Time zones: OK (now \" + et + \")\")\r",
                  "        except Exception as e:\r",
                  "            lines.append(\"Time zones: FAILED (\" + str(e)[:80] + \") - tzdata likely missing\")\r",
                  "        for package in (\"faster-whisper\", \"ctranslate2\", \"tzdata\", \"requests\", \"langflow\", \"lfx\"):\r",
                  "            lines.append(\"  \" + package + \": \" + _version(package))\r",
                  "\r",
                  "        lines.append(\"\")\r",
                  "        lines.append(\"== Storage ==\")\r",
                  "        tmp = tempfile.gettempdir()\r",
                  "        try:\r",
                  "            usage = shutil.disk_usage(tmp)\r",
                  "            lines.append(\"Temp dir \" + tmp + \": \" + _gb(usage.free) + \" free of \" + _gb(usage.total))\r",
                  "        except Exception:\r",
                  "            lines.append(\"Temp dir: \" + tmp)\r",
                  "        for name in (\"qa_transcript_cache\", \"ceq_dispatcher\", \"qa_model_benchmark\"):\r",
                  "            size = _dir_size(os.path.join(tmp, name))\r",
                  "            lines.append(\"  \" + name + \": \" + (\"not present\" if size is None else _gb(size)))\r",
                  "        hf_home = os.environ.get(\"HF_HOME\") or os.path.join(os.path.expanduser(\"~\"), \".cache\", \"huggingface\")\r",
                  "        hf_size = _dir_size(hf_home)\r",
                  "        lines.append(\"Model cache \" + hf_home + \": \" + (\"not present\" if hf_size is None else _gb(hf_size)))\r",
                  "        for var in (\"LANGFLOW_CONFIG_DIR\", \"LANGFLOW_SAVE_DB_IN_CONFIG_DIR\", \"LANGFLOW_WORKERS\"):\r",
                  "            if os.environ.get(var):\r",
                  "                lines.append(var + \" = \" + os.environ.get(var))\r",
                  "        config_dir = os.environ.get(\"LANGFLOW_CONFIG_DIR\")\r",
                  "        if config_dir:\r",
                  "            lines.append(\"Config dir writable: \" + str(os.access(config_dir, os.W_OK)))\r",
                  "\r",
                  "        lines.append(\"\")\r",
                  "        lines.append(\"== Workers / Persistence (run this 5+ times, minutes apart) ==\")\r",
                  "        boot_id = _read(\"/proc/sys/kernel/random/boot_id\")[:8] or \"unknown\"\r",
                  "        try:\r",
                  "            with open(_HISTORY_FILE, \"r\", encoding=\"utf-8\") as f:\r",
                  "                history = json.load(f)\r",
                  "        except Exception:\r",
                  "            history = {\"created\": now, \"runs\": []}\r",
                  "        history[\"runs\"].append({\"t\": now, \"host\": host, \"pid\": pid, \"boot\": boot_id})\r",
                  "        history[\"runs\"] = history[\"runs\"][-50:]\r",
                  "        try:\r",
                  "            with open(_HISTORY_FILE, \"w\", encoding=\"utf-8\") as f:\r",
                  "                json.dump(history, f)\r",
                  "        except Exception as e:\r",
                  "            lines.append(\"Could not write history file: \" + str(e)[:80])\r",
                  "        hosts = sorted(set(r[\"host\"] for r in history[\"runs\"]))\r",
                  "        pids = sorted(set(str(r[\"pid\"]) for r in history[\"runs\"]))\r",
                  "        boots = sorted(set(r[\"boot\"] for r in history[\"runs\"]))\r",
                  "        lines.append(\"Runs recorded in this temp dir: \" + str(len(history[\"runs\"])))\r",
                  "        lines.append(\"Temp history file first created: \" + str(int((now - history[\"created\"]) / 60)) + \" min ago\")\r",
                  "        lines.append(\"Distinct hosts seen: \" + str(len(hosts)) + \" (\" + \", \".join(hosts) + \")\")\r",
                  "        lines.append(\"Distinct processes seen: \" + str(len(pids)))\r",
                  "        lines.append(\"Distinct boots seen: \" + str(len(boots)))\r",
                  "\r",
                  "        lines.append(\"\")\r",
                  "        lines.append(\"== Connectivity ==\")\r",
                  "        targets = [\r",
                  "            (\"Genesys login\", \"https://login.mypurecloud.com\"),\r",
                  "            (\"Genesys API\", \"https://api.mypurecloud.com/api/v2/health/check\"),\r",
                  "            (\"Matcha API\", \"https://matcha.harriscomputer.com/rest/api/v1/llms\"),\r",
                  "        ]\r",
                  "        for label, url in targets:\r",
                  "            start = time.time()\r",
                  "            try:\r",
                  "                resp = requests.get(url, timeout=8)\r",
                  "                lines.append(\r",
                  "                    \"  \" + label + \": HTTP \" + str(resp.status_code) + \" in \"\r",
                  "                    + str(int((time.time() - start) * 1000)) + \" ms\"\r",
                  "                )\r",
                  "            except Exception as e:\r",
                  "                lines.append(\"  \" + label + \": FAILED (\" + str(e)[:80] + \")\")\r",
                  "\r",
                  "        lines.append(\"\")\r",
                  "        lines.append(\"== How to read the worker section ==\")\r",
                  "        lines.append(\"1 host + 1 process across many runs: single worker; in-memory locks are safe.\")\r",
                  "        lines.append(\"Several processes or hosts: multiple workers; the Dispatcher needs file locks.\")\r",
                  "        lines.append(\"Run count resets to 1 later: temp storage was cleared (restart/redeploy).\")\r",
                  "        lines.append(\"Matcha API 401 is expected here (no key sent); it proves the network path works.\")\r",
                  "\r",
                  "        return Message(text=\"\\n\".join(lines))"
                ]
              },
              "is_refresh": false
            },
            "tool_mode": false
          },
          "showNode": true,
          "type": "CustomComponent"
        },
